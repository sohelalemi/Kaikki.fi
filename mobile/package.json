{
  "name": "kaikki-mobile",
  "version": "0.5.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "npx expo-doctor",
    "preflight:ios": "node scripts/preflight.js",
    "check": "npm run preflight:ios && npx expo-doctor && npx expo export --platform ios --output-dir dist-ios",
    "build:android:preview": "npx eas-cli build --platform android --profile preview",
    "build:android:production": "npx eas-cli build --platform android --profile production",
    "submit:android": "npx eas-cli submit --platform android --latest",
    "build:ios:preview": "npm run preflight:ios && npx eas-cli build --platform ios --profile preview",
    "build:ios:production": "npm run preflight:ios && npx eas-cli build --platform ios --profile production",
    "submit:ios": "npm run preflight:ios && npx eas-cli submit --platform ios --latest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.56.0",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.13",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-url-polyfill": "^2.0.0"
  }
}

{
  "cli": {"version": ">= 16.0.0"},
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.14.0",
      "env": {"EAS_NO_FROZEN_LOCKFILE": "1"}
    },
    "preview": {
      "distribution": "internal",
      "node": "22.14.0",
      "android": {"buildType": "apk"},
      "env": {"EAS_NO_FROZEN_LOCKFILE": "1"}
    },
    "production": {
      "autoIncrement": true,
      "node": "22.14.0",
      "android": {"buildType": "app-bundle"},
      "env": {"EAS_NO_FROZEN_LOCKFILE": "1"}
    }
  },
  "submit": {"production": {}}
}
